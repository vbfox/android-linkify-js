{
  "name": "android-linkify-js",
  "version": "0.1.0",
  "description": "A Typescript port of Android Linkify utility",
  "keywords": [
    "link",
    "linkify",
    "parse"
  ],
  "license": "Apache-2.0",
  "author": "Julien Roncaglia <julien@roncaglia.fr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbfox/android-linkify-js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "lefthook install",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "preversion": "yarn build",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unplugin-unused": "^0.6.0",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "lefthook": {
      "built": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.18.0"
}

{
  "name": "android-linkify-js",
  "version": "0.1.0",
  "description": "A Typescript port of Android Linkify utility",
  "type": "module",
  "repository": "https://github.com/vbfox/android-linkify-js",
  "author": "Julien Roncaglia <julien@roncaglia.fr>",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "preversion": "yarn build",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "link",
    "linkify",
    "parse"
  ],
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0"
}

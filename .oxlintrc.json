{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "es2023": true
  },
  "ignorePatterns": ["dist/", ".yarn/"],
  "rules": {}
}
